# ==============================================================================
# TerraTern Lead Page Engine & Admin Portal - Environment Variables
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Legacy Anon API Key (Client & Browser requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Publishable Key (Modern sb_publishable_... key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Service Role Secret Key (Server-side ONLY - bypasses RLS for public API writes)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin API Secret Token (Protects POST /api/v1/admin/pages/register)
# Set to any strong random string of your choice
ADMIN_API_TOKEN=your-random-admin-api-secret-token

# Secret Key for HMAC-SHA256 signing of 10-minute temporary PDF download tokens
DOWNLOAD_SECRET=your-random-download-secret-key

# AI Generation Engine Keys (Vibe Studio)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
